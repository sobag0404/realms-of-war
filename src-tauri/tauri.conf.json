{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Realms of War",
  "version": "0.2.0",
  "identifier": "com.realmsofwar.game",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run desktop:static:build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Realms of War",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "Turn-based fantasy strategy",
    "longDescription": "Realms of War is a local-first turn-based fantasy strategy game."
  }
}

